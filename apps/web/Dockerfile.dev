# ── Development Dockerfile with HMR support ─────────────────────────────────
FROM oven/bun:1

WORKDIR /app

# Copy all workspace manifests first for layer caching
COPY package.json bun.lock ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/
COPY apps/ai-service/package.json ./apps/ai-service/

# Install dependencies
RUN bun install --frozen-lockfile

# Copy source
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

# Clerk publishable key (optional — app works without it)
ARG VITE_CLERK_PUBLISHABLE_KEY
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY

# Expose port
EXPOSE 3001

# Run in development mode with HMR
CMD ["bun", "run", "--cwd", "apps/web", "dev"]