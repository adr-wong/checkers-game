# Web service
PORT=3000
MONGODB_URI=mongodb://mongodb:27017/checkers
AI_SERVICE_URL=http://ai-service:4000
AI_REQUEST_TIMEOUT_MS=10000

# AI service
# PORT=4000
# ALLOWED_ORIGIN=*

# Clerk Authentication (optional — app works without it)
# Get keys from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# MongoDB (no auth for local dev)
# To enable auth, set these AND update MONGODB_URI to:
# mongodb://admin:yourpassword@mongodb:27017/checkers?authSource=admin
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=yourpassword
